{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RKN",
  "version": "0.1.6",
  "identifier": "com.freedom.rkn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RKN",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "externalBin": [
      "bins/sing-box"
    ],
    "resources": {
      "bins/libcronet.dll": "libcronet.dll",
      "bins/wintun.dll": "wintun.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "frameworks": [],
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 430
        },
        "appPosition": {
          "x": 150,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 450,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
