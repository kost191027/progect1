{
  "name": "rkn",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android:init": "node scripts/run-android-tauri.mjs init",
    "tauri:android:dev": "node scripts/run-android-tauri.mjs dev",
    "tauri:android:run": "node scripts/run-android-tauri.mjs run",
    "tauri:android:build:apk": "node scripts/run-android-tauri.mjs build --apk --target aarch64",
    "tauri:android:build:aab": "node scripts/run-android-tauri.mjs build --aab --target aarch64",
    "android:doctor": "node scripts/android-doctor.mjs",
    "version:sync": "node scripts/version-manager.mjs sync",
    "version:check": "node scripts/version-manager.mjs check",
    "version:bump": "node scripts/version-manager.mjs bump",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.0.4"
  }
}
